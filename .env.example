# Database
DATABASE_URL="mysql://user:password@host:port/database"

# JWT Secret
JWT_SECRET="your-secure-jwt-secret-key-here"

# SMTP Email Configuration (Hostinger)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@coachhimanshu.com"
SMTP_PASSWORD="your-email-password-here"

# Cron Job Security
CRON_SECRET="your-random-secret-key-for-cron-jobs"

# Cashfree (Payment Gateway) — Dashboard → Developers → API Keys
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"
CASHFREE_ENV="sandbox"  # "production" for live payments

# Web Push Notifications (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:info@coachhimanshu.com"

# Application URL
NEXT_PUBLIC_APP_URL="https://coachhimanshu.com"

# Analytics & Search (SEO measurement)
# GA4 Measurement ID — enables Google Analytics when set (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=""
# Google Search Console verification token — the content value from the
# "HTML tag" verification method (Search Console → Settings → Ownership).
# Renders <meta name="google-site-verification"> when set.
GOOGLE_SITE_VERIFICATION=""
